# Optional path to a local OpenTelemetry Collector binary for make e2e.
OTELCOL_BIN=
# OTLP/HTTP exporter settings honored by the SDK when otlp is enabled.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# examples/backplane: daemon credential (required, no default) and local ports.
API_KEY=
APP_PORT=3000
BACKPLANE_PORT=43127
